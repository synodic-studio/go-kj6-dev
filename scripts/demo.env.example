# Local configuration for scripts/demo.sh. Copy to scripts/demo.env, which is
# gitignored: the token and the chat id are credentials, not source.
#
#   cp scripts/demo.env.example scripts/demo.env

# Telegram bot that sends the demo message. Talk to @BotFather for a token.
TELEGRAM_BOT_TOKEN=

# Destination chat. A negative id is a group or supergroup.
TELEGRAM_CHAT_ID=

# Optional topic id within a forum-style supergroup. Leave empty for the
# General topic or for an ordinary chat.
TELEGRAM_THREAD_ID=

# The vault and notes the wrapped links point at. These have to exist on the
# machine doing the tapping, or the handoff lands on a "vault not found"
# error instead of a note. DEMO_NOTE_ALT is optional and adds a second link,
# so there are two safe places to bounce between.
#
# Quote every value. This file is sourced, so a path with a space in it is
# otherwise read as a command.
DEMO_VAULT=""
DEMO_NOTE=""
DEMO_NOTE_ALT=""

# The label the /key beat asks for. Shown on the paste form.
DEMO_KEY_LABEL=openai-api-key
